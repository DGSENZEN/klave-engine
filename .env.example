# Klave Engine local configuration (copy to .env and adjust)
KLAVE_DATA_DIR=data
KLAVE_REPORTS_DIR=reports
# Path to the external DWG->DXF converter (e.g. ODA File Converter)
# KLAVE_CONVERTER_EXECUTABLE_PATH=/Applications/ODAFileConverter.app/Contents/MacOS/ODAFileConverter
KLAVE_OVERWRITE_CONVERTED_FILES=false
KLAVE_MAX_UPLOAD_BYTES=104857600
KLAVE_MAX_CONCURRENT_JOBS=2
KLAVE_MAX_QUEUED_JOBS=8
KLAVE_LOG_LEVEL=INFO
# Optional JSON file overriding detector configuration
# KLAVE_DETECTOR_CONFIG_PATH=detector_config.json

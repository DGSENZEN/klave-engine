# Klave Engine — local configuration reference.
# Copy to .env and adjust. Local compose credentials are not production secrets.

# --- Core ---
# KLAVE_DATA_DIR=data
# KLAVE_LOG_LEVEL=INFO

# --- DWG conversion (LibreDWG) ---
# KLAVE_CONVERTER_EXECUTABLE_PATH=/opt/homebrew/bin/dwg2dxf
# KLAVE_CONVERTER_TIMEOUT_SECONDS=120

# --- Detection / costing overrides ---
# KLAVE_DETECTOR_CONFIG_PATH=config/detectors.json
# KLAVE_COSTING_CONFIG_PATH=config/costing.json

# --- Workspace accounts (docker compose service: users-db) ---
# make users-db-up
KLAVE_USERS_DATABASE_URL=postgresql://klave_users:klave@127.0.0.1:5433/klave_users
KLAVE_WEB_ORIGIN=http://localhost:3000

# --- Google sign-in (optional) ---
# OAuth client type "Web application"; authorized redirect URI:
#   http://localhost:8000/auth/google/callback
# KLAVE_AUTH_GOOGLE_ID=
# KLAVE_AUTH_GOOGLE_SECRET=

# --- Workspace identity (one taller per deployment; more via CLI) ---
# KLAVE_WORKSPACE_SLUG=taller
# KLAVE_WORKSPACE_NAME=Taller
#   uv run python -m apps.api.auth.cli create-workspace otro "Otro taller"
#   uv run python -m apps.api.auth.cli invite-admin otro jefa@otro.mx

# --- Transactional mail (invitations, recovery, verification) ---
# Leave everything unset and links are written to data/outbox/*.json; the UI
# then tells admins to hand links over by other means. Configure ONE of:
# KLAVE_RESEND_API_KEY=
# KLAVE_SMTP_HOST=smtp.example.com
# KLAVE_SMTP_PORT=587
# KLAVE_SMTP_USER=
# KLAVE_SMTP_PASSWORD=
# KLAVE_SMTP_STARTTLS=true
# KLAVE_MAIL_FROM="Klave <no-reply@tu-dominio.mx>"
# KLAVE_MAIL_PROVIDER=auto   # auto | resend | smtp | outbox

# --- Hosting (set when web and API live on real domains) ---
# KLAVE_WEB_ORIGIN=https://app.taller.mx
# KLAVE_COOKIE_DOMAIN=.taller.mx        # share the session between app. and api.
# KLAVE_COOKIE_SAMESITE=lax             # "none" only when the API is on another site (forces Secure)
# KLAVE_EXTRA_ORIGINS=https://staging.taller.mx

# Lectura asistida por IA (opcional): un modelo de visión lee la imagen de cada hoja
# (cajetín, cuadros, notas, marcas) como sugerencia con procedencia. Sin clave la
# función se reporta como no configurada; las imágenes de las hojas siguen disponibles.
# ANTHROPIC_API_KEY=sk-ant-...

# Backend API origin (defaults to http://localhost:8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Authentication now lives in the FastAPI backend (see the repo root .env):
#   KLAVE_USERS_DATABASE_URL  — dedicated users PostgreSQL (make users-db-up)
#   KLAVE_AUTH_GOOGLE_ID / KLAVE_AUTH_GOOGLE_SECRET — Google sign-in, redirect
#     URI: http://localhost:8000/auth/google/callback
#   KLAVE_WEB_ORIGIN — where the API redirects after Google sign-in

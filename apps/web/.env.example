# Backend API origin (defaults to http://localhost:8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google sign-in (optional in local mode; the name-only flow works without it).
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud
# Console and register this redirect URI:
#   http://localhost:3000/api/auth/google/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Session-cookie signing secret. Required outside development;
# generate one with: openssl rand -base64 32
AUTH_SECRET=

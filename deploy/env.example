# Copy to .env.prod and fill in. Everything here is read by docker-compose.prod.yml.
KLAVE_DOMAIN=taller.mx            # serves app.taller.mx and api.taller.mx
KLAVE_ACME_EMAIL=tu@correo.mx     # Let's Encrypt notifications
KLAVE_USERS_DB_PASSWORD=          # long and random; used only inside the compose network

# Optional — Google sign-in (callback: https://api.<dominio>/auth/google/callback)
KLAVE_AUTH_GOOGLE_ID=
KLAVE_AUTH_GOOGLE_SECRET=

# Optional — outbound mail (invitations, recovery). Without it, links land in
# el outbox del servidor y el panel de administración los muestra para copiar.
KLAVE_RESEND_API_KEY=
KLAVE_SMTP_HOST=
KLAVE_SMTP_PORT=587
KLAVE_SMTP_USER=
KLAVE_SMTP_PASSWORD=
KLAVE_MAIL_FROM=

# Optional — lectura de hojas con IA. Proveedor: anthropic | gemini | auto
# (auto usa el que tenga credenciales, Claude primero). KLAVE_AI_MODEL
# sobreescribe el modelo por defecto del proveedor.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
KLAVE_AI_PROVIDER=auto
KLAVE_AI_MODEL=

BACKUP_KEEP_DAYS=14
KLAVE_LOG_LEVEL=INFO

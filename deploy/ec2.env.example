# On the EC2 server, copy to the gitignored .env.prod and edit there.
# Use a subdomain of the frontend's domain: no second domain purchase needed.
KLAVE_API_DOMAIN=api.klave.space
KLAVE_WEB_ORIGIN=https://www.klave.space
KLAVE_ACME_EMAIL=you@example.com
# Replace with 48 hex characters from: openssl rand -hex 24
KLAVE_USERS_DB_PASSWORD=
BACKUP_KEEP_DAYS=7
# Optional backend integrations; provider charges are separate from AWS credits.
# KLAVE_RESEND_API_KEY=
# KLAVE_MAIL_FROM="Klave <no-reply@example.com>"
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# KLAVE_AI_BUDGET_USD=5

{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Klave M0: private versioned encrypted backups and independent missing-heartbeat alarm. No automatic expiration.",
  "Parameters": {
    "BackupBucketName": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9-]{1,61}[a-z0-9]"
    },
    "InstanceId": {
      "Type": "String",
      "AllowedPattern": "i-[0-9a-f]{17}"
    },
    "InstanceRoleName": {
      "Type": "String",
      "Default": "klave-ec2-ssm"
    },
    "AlertEmail": {
      "Type": "String",
      "NoEcho": true,
      "AllowedPattern": "[^\\s@]+@[^\\s@]+\\.[^\\s@]+"
    }
  },
  "Resources": {
    "BackupBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Ref": "BackupBucketName"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "klave"
          },
          {
            "Key": "Purpose",
            "Value": "milestone-0-backups"
          }
        ]
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "BackupBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyNonTLS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "BackupBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${BackupBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "RequireExplicitSSES3",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${BackupBucket.Arn}/*"
              },
              "Condition": {
                "StringNotEquals": {
                  "s3:x-amz-server-side-encryption": "AES256"
                }
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "BackupAccess": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "klave-offsite-backup",
        "Roles": [
          {
            "Ref": "InstanceRoleName"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "CopyAndVerifyBackupObjects",
              "Effect": "Allow",
              "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:GetObjectVersion"
              ],
              "Resource": {
                "Fn::Sub": "${BackupBucket.Arn}/backups/*"
              }
            },
            {
              "Sid": "BackupHealthOnly",
              "Effect": "Allow",
              "Action": "cloudwatch:PutMetricData",
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "cloudwatch:namespace": "Klave/M0"
                }
              }
            }
          ]
        }
      }
    },
    "AlertTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "DisplayName": "Klave backup alerts"
      }
    },
    "EmailSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "Protocol": "email",
        "Endpoint": {
          "Ref": "AlertEmail"
        },
        "TopicArn": {
          "Ref": "AlertTopic"
        }
      }
    },
    "BackupAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "klave-m0-offsite-backup-health",
        "AlarmDescription": "Klave off-host backup failed/stale, disk/inode headroom low, or hourly heartbeat missing. Inspect private operator state.",
        "Namespace": "Klave/M0",
        "MetricName": "OffsiteBackupHealthy",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "InstanceId"
            }
          }
        ],
        "Statistic": "Minimum",
        "Period": 3600,
        "EvaluationPeriods": 2,
        "DatapointsToAlarm": 2,
        "Threshold": 1,
        "ComparisonOperator": "LessThanThreshold",
        "TreatMissingData": "breaching",
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlertTopic"
          }
        ]
      }
    },
    "AlertTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "AlertTopic"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::GetAtt": [
                      "BackupAlarm",
                      "Arn"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": {
        "Ref": "BackupBucket"
      }
    },
    "AlarmName": {
      "Value": {
        "Ref": "BackupAlarm"
      }
    },
    "AlertTopicArn": {
      "Value": {
        "Ref": "AlertTopic"
      }
    }
  }
}
